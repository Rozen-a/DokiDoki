<Window x:Class="DokiDoki.Frontend.HeartRateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DokiDoki" Width="520" Height="300" MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ComboBox x:Name="devices" AutomationProperties.Name="蓝牙设备" MinHeight="30" />
        <Button x:Name="scan" Grid.Column="1" Content="扫描" Margin="8,0,0,0" Padding="14,4" />
        <Button x:Name="connect" Grid.Column="2" Content="连接" Margin="8,0,0,0" Padding="14,4"
                IsEnabled="False" />
        <TextBlock x:Name="value" Grid.Row="1" Grid.ColumnSpan="3"
                   Text="— BPM" FontSize="56" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="status" Grid.Row="2" Grid.ColumnSpan="3" TextWrapping="Wrap"
                   Text="请在手环上开启心率广播" TextAlignment="Center" />
    </Grid>
</Window>
