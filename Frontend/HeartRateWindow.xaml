<Window x:Class="DokiDoki.Frontend.HeartRateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DokiDoki" Icon="/Frontend/Assets/Heart.png"
        Width="660" Height="660" MinWidth="490" MinHeight="580"
        Background="#EFF7FF" Foreground="#22354F"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#DDEEFF" />
            <Setter Property="Foreground" Value="#22354F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="#9DBEE4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="#54769D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="#F2F8FF" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#E1EEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#FBE0ED" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="#54769D" />
                                <Setter TargetName="row" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid x:Name="dashboard">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border CornerRadius="28" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="#FFE5F0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前心率" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="reading" Text="—" FontSize="55" FontWeight="Bold" />
                            <TextBlock Text="BPM" Margin="10,0,0,10" VerticalAlignment="Bottom" Foreground="#546681" />
                        </StackPanel>
                        <TextBlock x:Name="connectionState" Text="未连接设备" FontSize="19" FontWeight="Bold"
                                   Foreground="#9B2956" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="dashboardMessage" Text="在手环上开启心率广播，然后连接设备。"
                                   Margin="0,6,0,0" Foreground="#546681" TextWrapping="Wrap" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="/Frontend/Assets/Heart.png" Width="112" Height="112"
                           Margin="14,0,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,16" Background="White" CornerRadius="22" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="range" DockPanel.Dock="Right" Foreground="#546681" />
                        <TextBlock Text="最近 60 秒心率" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <Border Grid.Row="1" CornerRadius="14" Background="#F2F8FF" Margin="0,12,0,8">
                        <Grid Margin="12" ClipToBounds="True">
                            <Canvas x:Name="chart" SizeChanged="ChartSizeChanged" />
                            <TextBlock x:Name="chartHint" Text="连接后显示心率趋势" Foreground="#546681"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <TextBlock Text="现在" Foreground="#546681" DockPanel.Dock="Right" />
                        <TextBlock Text="60 秒前" Foreground="#546681" />
                    </DockPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
            <UniformGrid Columns="2">
                <Button x:Name="openDevices" Content="连接设备" Margin="0,0,6,0" Click="OpenDevicesClick" />
                <Button x:Name="disconnect" Content="断开连接" Margin="6,0,0,0" Background="#FBE0ED"
                        IsEnabled="False" Click="DisconnectClick" />
            </UniformGrid>
                <Button Content="悬浮窗设置" HorizontalAlignment="Right" Margin="0,10,0,0"
                        Background="White" Click="OpenOverlaySettingsClick" />
            </StackPanel>
        </Grid>

        <Border x:Name="devicePage" Background="White" CornerRadius="28" Padding="22" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <Button x:Name="back" DockPanel.Dock="Right" Content="返回" Click="BackClick" />
                    <TextBlock Text="连接设备" FontSize="26" FontWeight="Bold" />
                </DockPanel>
                <TextBlock x:Name="scanStatus" Grid.Row="1" Margin="0,12,0,12" TextWrapping="Wrap"
                           Foreground="#546681" AutomationProperties.LiveSetting="Polite" />
                <ListBox x:Name="devices" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="附近的蓝牙设备" SelectionChanged="DeviceSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="3" Columns="2" Margin="0,12,0,0">
                    <Button x:Name="rescan" Content="重新搜索" Margin="0,0,6,0" Click="RescanClick" />
                    <Button x:Name="connect" Content="连接" Margin="6,0,0,0" Background="#FBE0ED" Click="ConnectClick" />
                </UniformGrid>
            </Grid>
        </Border>

        <Border x:Name="toast" Panel.ZIndex="1" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,10" MaxWidth="290"
                Background="#FBE0ED" BorderBrush="#EFC6DB" BorderThickness="1" CornerRadius="22">
            <TextBlock x:Name="toastMessage" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
