<Window x:Class="DokiDoki.Frontend.HeartRateOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DokiDoki 悬浮窗" Width="240" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Border Background="#E8FFFFFF" BorderBrush="#DDEEFF" BorderThickness="1"
            CornerRadius="22" Padding="14" MouseLeftButtonDown="DragSurface">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <Image x:Name="heart" Width="48" Height="48" Source="/Frontend/Assets/Heart.png"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <StackPanel x:Name="rate" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="bpmText" Text="—" Foreground="#22354F" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="BPM" Foreground="#546681" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                </StackPanel>
            </DockPanel>
            <Border x:Name="trendPanel" Height="50" Margin="0,8,0,0" CornerRadius="12">
                <Grid Margin="5" ClipToBounds="True">
                    <Canvas x:Name="trend" SizeChanged="TrendSizeChanged" />
                    <TextBlock x:Name="trendHint" Text="等待心率数据" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="#546681" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
