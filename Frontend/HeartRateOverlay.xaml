<Window x:Class="DokiDoki.Frontend.HeartRateOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DokiDoki.Frontend"
        Title="DokiDoki 悬浮窗" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <StackPanel Background="Transparent" MouseLeftButtonDown="DragSurface">
        <!-- Reserve space for the heart's 18% render-time growth so the
             size-to-content window does not clip its pulse at either edge. -->
        <Grid x:Name="readingRow" HorizontalAlignment="Left" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:PulsingHeart x:Name="heart" Width="40" Height="40" Margin="-3,0" Source="/Frontend/Assets/Heart.png"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <StackPanel x:Name="rate" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <local:OutlinedText x:Name="bpmText" Text="—" Width="68" HorizontalContentAlignment="Right" Foreground="#22354F" FontSize="34" FontWeight="Bold" />
                <local:OutlinedText x:Name="bpmUnit" Text="BPM" Foreground="#394C68" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" Margin="0,0,0,7" />
            </StackPanel>
        </Grid>
        <Border x:Name="trendPanel" Width="{Binding ActualWidth, ElementName=readingRow}" HorizontalAlignment="Left" Height="33" Margin="0,2,0,0" CornerRadius="10">
            <Grid Margin="3" ClipToBounds="True">
                <Canvas x:Name="trend" SizeChanged="TrendSizeChanged" />
                <local:OutlinedText x:Name="trendHint" Text="等待心率数据" FontSize="11" Foreground="#394C68"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </Border>
        <Border x:Name="notice" Visibility="Collapsed" Background="#FFF2D6" CornerRadius="8"
                Padding="6,3" Margin="2,4" Width="130" IsHitTestVisible="False">
            <TextBlock x:Name="noticeText" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="#702B29" AutomationProperties.LiveSetting="Assertive" />
        </Border>
    </StackPanel>
</Window>
