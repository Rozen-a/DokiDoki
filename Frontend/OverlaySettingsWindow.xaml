<Window x:Class="DokiDoki.Frontend.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DokiDoki · 设置" Icon="/Frontend/Assets/Heart.png"
        Width="436" SizeToContent="Height" ResizeMode="NoResize"
        Background="#EFF7FF" Foreground="#22354F" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ControlTemplate x:Key="OptionTemplate" TargetType="ToggleButton">
            <Border x:Name="surface" Background="#E3F0FE" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="indicator" Width="19" Height="19" CornerRadius="7" Margin="0,0,8,0"
                            Background="White" BorderBrush="#829FBE" BorderThickness="1">
                        <Path x:Name="check" Data="M 0,4 L 3,7 L 8,1" Stroke="#743452" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter x:Name="label" Grid.Column="1" VerticalAlignment="Center"
                                      RecognizesAccessKey="True" TextElement.Foreground="#22354F" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="OverlayCard">
                    <Setter TargetName="surface" Property="CornerRadius" Value="22" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="surface" Property="Background" Value="#FAD7E8" />
                    <Setter TargetName="indicator" Property="Background" Value="#EEA6C8" />
                    <Setter TargetName="indicator" Property="BorderBrush" Value="#CA719E" />
                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="surface" Property="BorderBrush" Value="#9CB7D6" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="surface" Property="Background" Value="#F3F7FB" />
                    <Setter TargetName="surface" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="indicator" Property="Background" Value="#EBF0F6" />
                    <Setter TargetName="indicator" Property="BorderBrush" Value="#C8D4E2" />
                    <Setter TargetName="check" Property="Stroke" Value="#8599B1" />
                    <Setter TargetName="label" Property="TextElement.Foreground" Value="#77899F" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="OverlayOptionStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template" Value="{StaticResource OptionTemplate}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource OverlayOptionStyle}" />
        <Style TargetType="RadioButton" BasedOn="{StaticResource OverlayOptionStyle}" />
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#22354F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabSurface" Background="{StaticResource OptionIdleBrush}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="16" Padding="8,8" Margin="3,0,3,5" MinHeight="34">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabSurface" Property="Background" Value="White" />
                                <Setter TargetName="tabSurface" Property="CornerRadius" Value="16,16,0,0" />
                                <Setter TargetName="tabSurface" Property="Margin" Value="3,0,3,0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabSurface" Property="BorderBrush" Value="#9DBEE4" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DurationChoice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#22354F" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="shell" Background="{StaticResource OptionIdleBrush}"
                                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Right" Data="M 0,0 L 3,3 L 6,0" Stroke="#456382"
                                                      StrokeThickness="1.4" VerticalAlignment="Center" Margin="5,0,0,0" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="shell" Property="BorderBrush" Value="#9DBEE4" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="shell" Property="Background" Value="{StaticResource OptionActiveBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" CornerRadius="12" Padding="4" Margin="0,4"
                                        BorderBrush="#DDEEFF" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="item" Background="Transparent" CornerRadius="7" Padding="8,2" Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="item" Property="Background" Value="{StaticResource OptionIdleBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="item" Property="Background" Value="{StaticResource OptionActiveBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DurationInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#22354F" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="field" Background="#EFF7FF" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="12" Padding="7,4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="#9DBEE4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="field" Property="Background" Value="{StaticResource OptionActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="field" Property="Opacity" Value=".45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl Margin="18" UseLayoutRounding="True">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" IsItemsHost="True" Margin="0,0,0,-1" Panel.ZIndex="1"
                                 KeyboardNavigation.TabNavigation="Once" />
                    <Border Grid.Row="1" Background="White" CornerRadius="0,0,20,20" Padding="16">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="直播">
                <StackPanel>
                    <TextBlock Text="浏览器采集链接" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="captureAddress" IsReadOnly="True" Margin="0,6,0,14" Padding="7"
                             AutomationProperties.Name="浏览器采集链接" />
                    <Border Background="#EFF7FF" CornerRadius="12" Padding="12">
                        <TextBlock TextWrapping="Wrap" LineHeight="24"
                                   Text="1. 在主界面开启「直播采集」。&#10;2. 在 OBS 添加「浏览器」来源并粘贴链接。&#10;3. 来源宽度设为 960，高度设为 720，再在场景中等比缩放。&#10;只想在直播中显示时，关闭「桌面悬浮窗」。" />
                    </Border>
                </StackPanel>

        </TabItem>
        <TabItem Header="悬浮窗">
            <StackPanel>
                <TextBlock Text="悬浮窗样式" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="heartRight" Content="爱心右置" GroupName="OverlayLayout" />
                    <RadioButton x:Name="rateRight" Grid.Row="1" Content="心率右置" GroupName="OverlayLayout" />
                    <CheckBox x:Name="locked" Grid.Row="2" Content="位置锁定"
                              />
                    <CheckBox x:Name="showTrend" Grid.Column="2" Content="显示波动" />
                    <CheckBox x:Name="showBackground" Grid.Row="1" Grid.Column="2"
                              IsEnabled="{Binding IsChecked, ElementName=showTrend}" AutomationProperties.Name="波动半透明背景">
                        <TextBlock Text="波动半透明背景" TextWrapping="NoWrap" />
                    </CheckBox>
                    <CheckBox x:Name="hideBpm" Grid.Row="2" Grid.Column="2" Content="隐藏 BPM" />
                </Grid>
            </StackPanel>

        </TabItem>
        <TabItem Header="连接">
                <StackPanel>
                    <DockPanel>
                        <Label DockPanel.Dock="Right" Style="{StaticResource HelpBadgeStyle}" AutomationProperties.Name="使用说明">
                            <Label.ToolTip><ToolTip><TextBlock MaxWidth="270" TextWrapping="Wrap" Text="启动后搜索最近连接的设备，直到连上、达到设定时长或手动取消。" /></ToolTip></Label.ToolTip>
                        </Label>
                        <CheckBox x:Name="startup" Content="应用启动时自动连接" />
                    </DockPanel>
                    <DockPanel Margin="10,4,0,10" IsEnabled="{Binding IsChecked, ElementName=startup}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="startupDuration" Style="{StaticResource DurationChoice}" MinWidth="88" AutomationProperties.Name="启动自动连接时长">
                                <ComboBoxItem Content="不限时" />
                                <ComboBoxItem Content="设置时限" />
                            </ComboBox>
                            <TextBox x:Name="startupSeconds" Style="{StaticResource DurationInput}" Width="62" Margin="6,0,0,0"
                                     AutomationProperties.Name="启动自动连接时长（秒）" />
                            <TextBlock x:Name="startupSecondsUnit" Text="秒" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="启动自动连接时长" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </DockPanel>
                    <DockPanel>
                        <Label DockPanel.Dock="Right" Style="{StaticResource HelpBadgeStyle}" AutomationProperties.Name="使用说明">
                            <Label.ToolTip><ToolTip><TextBlock MaxWidth="270" TextWrapping="Wrap" Text="意外断连后按设定时长尝试重连。主动断开时不会重连。" /></ToolTip></Label.ToolTip>
                        </Label>
                        <CheckBox x:Name="reconnect" Content="自动重连" />
                    </DockPanel>
                    <DockPanel Margin="10,4,0,10" IsEnabled="{Binding IsChecked, ElementName=reconnect}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="reconnectDuration" Style="{StaticResource DurationChoice}" MinWidth="88" AutomationProperties.Name="自动重连时长">
                                <ComboBoxItem Content="不限时" />
                                <ComboBoxItem Content="设置时限" />
                            </ComboBox>
                            <TextBox x:Name="reconnectSeconds" Style="{StaticResource DurationInput}" Width="62" Margin="6,0,0,0"
                                     AutomationProperties.Name="自动重连时长（秒）" />
                            <TextBlock x:Name="reconnectSecondsUnit" Text="秒" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="自动重连时长" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </DockPanel>
                </StackPanel>

        </TabItem>
    </TabControl>
</Window>
